# Supabase — get these from: supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Tawk.to — get from: tawk.to → Admin → Property Settings → Widget Code
# Copy only the Property ID (the part after tawk.to/)
NEXT_PUBLIC_TAWKTO_PROPERTY_ID=your-property-id
NEXT_PUBLIC_TAWKTO_WIDGET_ID=default

# Callmebot WhatsApp alerts — see supabase/SETUP.md for activation steps
CALLMEBOT_API_KEY=your-callmebot-api-key
CALLMEBOT_PHONE=12025792944
